---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Sombra Workshop Blog.</p>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		margin-top: auto;
	}

	p {
		max-width: 680px;
		padding: 44px 16px;
		margin: 0 auto;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.875rem;
		line-height: 1.4;
		margin: 0;
	}
</style>
