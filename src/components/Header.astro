---
import { SITE_TITLE } from '../consts';
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faMoon, faSun } from '@fortawesome/free-regular-svg-icons';

const moonIconSvg = icon(faMoon).html.join('');
const sunIconSvg = icon(faSun).html.join('');
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<button class="theme-toggle" type="button" aria-pressed="false" aria-label="Enable dark mode">
			<span class="theme-toggle-icon moon" aria-hidden="true" set:html={moonIconSvg}></span>
			<span class="theme-toggle-icon sun" aria-hidden="true" set:html={sunIconSvg}></span>
		</button>
	</nav>
</header>
<script is:inline>
	const toggleButton = document.querySelector('.theme-toggle');

	if (toggleButton) {
		const root = document.documentElement;

		const updateToggle = (theme) => {
			const isDark = theme === 'dark';
			toggleButton.setAttribute('aria-pressed', String(isDark));
			toggleButton.setAttribute('aria-label', isDark ? 'Enable light mode' : 'Enable dark mode');
		};

		updateToggle(root.dataset.theme ?? 'light');

		toggleButton.addEventListener('click', () => {
			const currentTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
			const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

			root.dataset.theme = nextTheme;
			localStorage.setItem('theme', nextTheme);
			updateToggle(nextTheme);
		});
	}
</script>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}

	h2 {
		margin: 0;
		font-size: 1.75rem;
		line-height: 1;
		font-weight: 400;
	}

	h2 a {
		text-decoration: none;
		color: var(--text-primary);
	}

	nav {
		max-width: 680px;
		height: 60px;
		padding: 0 16px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.theme-toggle {
		border: 0;
		background: transparent;
		color: #525252;
		width: 16px;
		height: 16px;
		padding: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		border-radius: 4px;
		cursor: pointer;
		transition: color 150ms ease;
	}

	.theme-toggle-icon {
		position: absolute;
		inset: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 16px;
		line-height: 1;
	}

	.theme-toggle-icon :global(svg) {
		width: 12px;
		height: 12px;
		display: block;
	}

	.theme-toggle .sun {
		display: none;
	}

	.theme-toggle[aria-pressed='true'] .sun {
		display: inline-flex;
	}

	.theme-toggle[aria-pressed='true'] .moon {
		display: none;
	}

	.theme-toggle:hover {
		color: var(--text-primary);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}
</style>
