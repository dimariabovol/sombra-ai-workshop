---
import { SITE_TITLE } from '../consts';
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faMoon, faSun, faBars, faXmark } from '@fortawesome/free-solid-svg-icons';

const moonIconSvg = icon(faMoon).html.join('');
const sunIconSvg = icon(faSun).html.join('');
const barsIconSvg = icon(faBars).html.join('');
const closeIconSvg = icon(faXmark).html.join('');
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="nav-right">
			<a class="nav-link" href="/">Posts</a>
			<a class="nav-link" href="/about">About</a>
			<button class="theme-toggle" type="button" aria-pressed="false" aria-label="Enable dark mode">
				<span class="theme-toggle-icon moon" aria-hidden="true" set:html={moonIconSvg}></span>
				<span class="theme-toggle-icon sun" aria-hidden="true" set:html={sunIconSvg}></span>
			</button>
			<button class="menu-toggle" type="button" aria-expanded="false" aria-label="Open menu">
				<span class="menu-icon bars" aria-hidden="true" set:html={barsIconSvg}></span>
				<span class="menu-icon close" aria-hidden="true" set:html={closeIconSvg}></span>
			</button>
		</div>
	</nav>
	<div class="mobile-menu">
		<a href="/">Posts</a>
		<a href="/about">About</a>
	</div>
</header>
<script is:inline>
	const toggleButton = document.querySelector('.theme-toggle');
	const menuButton = document.querySelector('.menu-toggle');
	const headerEl = document.querySelector('header');

	if (toggleButton) {
		const root = document.documentElement;

		const updateToggle = (theme) => {
			const isDark = theme === 'dark';
			toggleButton.setAttribute('aria-pressed', String(isDark));
			toggleButton.setAttribute('aria-label', isDark ? 'Enable light mode' : 'Enable dark mode');
		};

		updateToggle(root.dataset.theme ?? 'light');

		toggleButton.addEventListener('click', () => {
			const currentTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
			const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

			root.dataset.theme = nextTheme;
			localStorage.setItem('theme', nextTheme);
			updateToggle(nextTheme);
		});
	}

	if (menuButton && headerEl) {
		const closeMenu = () => {
			headerEl.classList.remove('menu-open');
			menuButton.setAttribute('aria-expanded', 'false');
			menuButton.setAttribute('aria-label', 'Open menu');
		};

		menuButton.addEventListener('click', () => {
			const isOpen = headerEl.classList.toggle('menu-open');
			menuButton.setAttribute('aria-expanded', String(isOpen));
			menuButton.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
		});

		headerEl.querySelectorAll('.mobile-menu a').forEach((link) => {
			link.addEventListener('click', closeMenu);
		});
	}
</script>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}

	nav {
		max-width: 680px;
		height: 60px;
		padding: 0 16px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		font-size: 16px;
		font-weight: 700;
		line-height: 1.7;
		color: var(--text-primary);
		text-decoration: none;
		border-radius: 4px;
	}

	.brand:hover {
		text-decoration: none;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.nav-link {
		font-size: 14px;
		line-height: 1.428;
		color: var(--text-muted);
		text-decoration: none;
		border-radius: 4px;
	}

	.nav-link:hover {
		color: var(--text-primary);
		text-decoration: none;
	}

	.theme-toggle {
		border: 0;
		background: transparent;
		color: var(--text-muted);
		width: 36px;
		height: 36px;
		padding: 10px;
		margin: -10px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		position: relative;
		border-radius: 4px;
		cursor: pointer;
		transition: color 150ms ease;
	}

	.theme-toggle-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 16px;
		line-height: 1;
	}

	.theme-toggle-icon :global(svg) {
		width: 16px;
		height: 16px;
		display: block;
	}

	.theme-toggle .sun {
		display: none;
	}

	.theme-toggle[aria-pressed='true'] .sun {
		display: inline-flex;
	}

	.theme-toggle[aria-pressed='true'] .moon {
		display: none;
	}

	.theme-toggle:hover {
		color: var(--text-primary);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}

	/* Hamburger menu toggle — hidden on desktop */
	.menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		border: 0;
		background: transparent;
		color: var(--text-muted);
		padding: 0;
		font-size: 0;
		cursor: pointer;
		border-radius: 4px;
		transition: color 150ms ease;
	}

	.menu-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		line-height: 1;
	}

	.menu-icon :global(svg) {
		width: 20px;
		height: 20px;
		display: block;
	}

	.menu-toggle .close {
		display: none;
	}

	.menu-toggle[aria-expanded='true'] .close {
		display: inline-flex;
	}

	.menu-toggle[aria-expanded='true'] .bars {
		display: none;
	}

	.menu-toggle:hover {
		color: var(--text-primary);
	}

	.menu-toggle:focus-visible {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}

	/* Mobile menu panel — hidden by default */
	.mobile-menu {
		display: none;
	}

	@media (max-width: 768px) {
		.nav-link {
			display: none;
		}

		.nav-right {
			gap: 16px;
		}

		.menu-toggle {
			display: inline-flex;
		}

		header.menu-open .mobile-menu {
			display: flex;
			flex-direction: column;
			padding: 0 16px 16px;
		}

		.mobile-menu a {
			display: block;
			padding: 12px 0;
			font-size: 14px;
			line-height: 1.428;
			color: var(--text-muted);
			text-decoration: none;
			border-top: 1px solid var(--border);
		}

		.mobile-menu a:hover {
			color: var(--text-primary);
			text-decoration: none;
		}
	}
</style>
