---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}

	h2 {
		margin: 0;
		font-size: 1.75rem;
		line-height: 1;
		font-weight: 400;
	}

	h2 a {
		text-decoration: none;
		color: var(--text-primary);
	}

	nav {
		max-width: 680px;
		height: 60px;
		padding: 0 16px;
		margin: 0 auto;
		display: flex;
		align-items: center;
	}
</style>
