---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faClock } from '@fortawesome/free-regular-svg-icons';

type Props = CollectionEntry<'blog'>['data'];

interface BlogPostProps extends Props {
	readingTime: string;
}

const { title, description, pubDate, readingTime } = Astro.props as BlogPostProps;
const clockIconSvg = icon(faClock).html.join('');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post {
				display: grid;
				gap: 32px;
			}

			.post-header {
				display: grid;
				gap: 16px;
			}

			.post-title {
				color: var(--brand);
				font-size: 36px;
				line-height: 1.3;
			}

			.meta {
				display: inline-flex;
				gap: 16px;
				align-items: center;
				font-size: 14px;
				line-height: 1.428;
				color: var(--text-muted);
			}

			.reading-time {
				display: inline-flex;
				gap: 4px;
				align-items: center;
			}

			.clock-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 16px;
				height: 16px;
			}

			.clock-icon :global(svg) {
				width: 16px;
				height: 16px;
				display: block;
			}

			.post-content {
				display: grid;
				gap: 24px;
				font-size: 16px;
				line-height: 1.625;
				color: var(--text-secondary);
			}

			.post-content :global(p) {
				margin: 0;
			}

			.post-content :global(h2) {
				margin-top: 16px;
				font-size: 24px;
				line-height: 1.333;
				color: var(--text-primary);
			}

			.post-content :global(pre) {
				margin: 0;
			}

			.post-footer {
				margin-top: 32px;
				padding-top: 32px;
				border-top: 1px solid var(--border);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 16px;
			}

			.back-link {
				font-size: 16px;
				line-height: 1.7;
				color: var(--text-primary);
				text-decoration: none;
			}

			.back-link:hover {
				text-decoration: underline;
			}

			.share {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				color: var(--text-muted);
				font-size: 14px;
			}

			.share a {
				color: inherit;
				text-decoration: none;
				font-size: 16px;
			}

			.share a:hover {
				text-decoration: underline;
			}

			@media (max-width: 768px) {
				.post-title {
					font-size: 32px;
				}

				.post-footer {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<header class="post-header">
					<h1 class="post-title">{title}</h1>
					<div class="meta">
						<FormattedDate date={pubDate} />
						<span class="reading-time">
							<span class="clock-icon" aria-hidden="true" set:html={clockIconSvg} />
							{readingTime}
						</span>
					</div>
				</header>
				<div class="post-content">
					<slot />
				</div>
				<footer class="post-footer">
					<a class="back-link" href="/">&larr; Back to Posts</a>
					<div class="share">
						<span>Share:</span>
						<a href="#" aria-label="Share on X">X</a>
						<a href="#" aria-label="Share on LinkedIn">in</a>
						<a href="#" aria-label="Copy link">⎘</a>
					</div>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>
