---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

interface BlogPostProps extends Props {
	readingTime: string;
}

const { title, description, pubDate, readingTime } = Astro.props as BlogPostProps;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post {
				display: grid;
				gap: 2rem;
			}

			.post-header {
				display: grid;
				gap: 1rem;
			}

			.post-title {
				color: var(--brand);
				font-size: 2.25rem;
				line-height: 1.3;
			}

			.meta {
				display: inline-flex;
				gap: 1rem;
				align-items: center;
				font-size: 0.875rem;
				line-height: 1.428;
				color: #525252;
			}

			.reading-time {
				display: inline-flex;
				gap: 0.25rem;
				align-items: center;
			}

			.reading-time::before {
				content: '';
				display: inline-block;
				width: 12px;
				height: 12px;
				border: 1px solid currentColor;
				border-radius: 50%;
			}

			.post-content {
				display: grid;
				gap: 1.5rem;
				font-size: 1rem;
				line-height: 1.625;
				color: var(--text-secondary);
			}

			.post-content :global(p) {
				margin: 0;
			}

			.post-content :global(h2) {
				margin-top: 1rem;
				font-size: 1.5rem;
				line-height: 1.333;
				color: var(--text-primary);
			}

			.post-content :global(pre) {
				margin: 0;
			}

			.post-footer {
				margin-top: 2rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
			}

			.back-link {
				font-size: 1rem;
				line-height: 1.7;
				color: var(--text-primary);
				text-decoration: none;
			}

			.back-link:hover {
				text-decoration: underline;
			}

			.share {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: #525252;
				font-size: 0.875rem;
			}

			.share a {
				color: inherit;
				text-decoration: none;
				font-size: 1rem;
			}

			.share a:hover {
				text-decoration: underline;
			}

			@media (max-width: 768px) {
				.post-title {
					font-size: 2rem;
				}

				.post-footer {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<header class="post-header">
					<h1 class="post-title">{title}</h1>
					<div class="meta">
						<FormattedDate date={pubDate} />
						<span class="reading-time">{readingTime}</span>
					</div>
				</header>
				<div class="post-content">
					<slot />
				</div>
				<footer class="post-footer">
					<a class="back-link" href="/">&larr; Back to Posts</a>
					<div class="share">
						<span>Share:</span>
						<a href="#" aria-label="Share on X">X</a>
						<a href="#" aria-label="Share on LinkedIn">in</a>
						<a href="#" aria-label="Copy link">⎘</a>
					</div>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>
