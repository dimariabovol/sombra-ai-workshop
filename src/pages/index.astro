---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Avatar from '../assets/avatar.avif';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { estimateReadingTime } from '../utils/readingTime';
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faClock } from '@fortawesome/free-regular-svg-icons';

const clockIconSvg = icon(faClock).html.join('');

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: grid;
				grid-template-columns: 128px 1fr;
				align-items: start;
				gap: 24px;
				margin-bottom: 64px;
			}

			.hero-avatar {
				width: 128px;
				height: 128px;
				border-radius: 50%;
				object-fit: cover;
			}

			.hero-content {
				display: flex;
				flex-direction: column;
				gap: 16px;
			}

			.hero-title {
				margin: 0;
				font-size: 36px;
				line-height: 1.3;
				color: var(--text-primary);
			}

			.hero-description {
				margin: 0;
				font-size: 16px;
				line-height: 1.625;
				color: var(--text-secondary);
			}

			.posts-section {
				padding-top: 32px;
			}

			.posts {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 48px;
			}

			.post-item {
				display: grid;
				gap: 8px;
			}

			.post-title {
				font-size: 18px;
				line-height: 1.555;
				margin: 0;
				color: var(--brand);
			}

			.post-title a {
				color: inherit;
				text-decoration: none;
			}

			.post-title a:hover {
				text-decoration: underline;
			}

			.post-meta {
				margin: 0;
				display: inline-flex;
				align-items: center;
				gap: 12px;
				color: var(--text-muted);
				font-size: 14px;
				line-height: 1.428;
			}

			.reading-time {
				display: inline-flex;
				align-items: center;
				gap: 4px;
			}

			.clock-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 14px;
				height: 14px;
			}

			.clock-icon :global(svg) {
				width: 14px;
				height: 14px;
				display: block;
			}

			.post-description {
				margin: 0;
				color: var(--text-muted);
				font-size: 14px;
				line-height: 1.428;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.all-posts-link {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				margin-top: 48px;
				font-size: 16px;
				line-height: 1.7;
				color: var(--text-primary);
				text-decoration: none;
			}

			.all-posts-link:hover {
				text-decoration: underline;
			}

			.all-posts-link .arrow {
				font-size: 16px;
			}

			@media (max-width: 768px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 24px;
					margin-bottom: 48px;
				}

				.hero-avatar {
					width: 128px;
					height: 128px;
				}

				.posts {
					gap: 48px;
				}

				.post-description {
					white-space: normal;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<img
					class="hero-avatar"
					src={Avatar.src}
					width={128}
					height={128}
					alt="Author avatar"
					loading="eager"
					decoding="async"
				/>
				<div class="hero-content">
					<h1 class="hero-title" id="hero-title">Hi there!</h1>
					<p class="hero-description">AI-powered tools from Swift roots to web frontiers.</p>
					<p class="hero-description">{SITE_DESCRIPTION}</p>
				</div>
			</section>
			<section class="posts-section">
				<ul class="posts">
					{
						posts.map((post) => (
							<li>
								<article class="post-item">
									<h3 class="post-title">
										<a href={`/posts/${post.id}/`}>{post.data.title}</a>
									</h3>
								<p class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									<span class="reading-time">
										<span class="clock-icon" aria-hidden="true" set:html={clockIconSvg} />
										{estimateReadingTime(post.body ?? '')}
									</span>
								</p>
									<p class="post-description">{post.data.description}</p>
								</article>
							</li>
						))
					}
				</ul>
			<a class="all-posts-link" href="/posts/">
				All Posts <span class="arrow">&rarr;</span>
			</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
