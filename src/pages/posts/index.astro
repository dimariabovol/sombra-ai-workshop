---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { estimateReadingTime } from '../../utils/readingTime';
import { clockIcon } from '../../utils/icons';


const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type MonthGroup = {
	label: string;
	posts: typeof posts;
};

const monthGroups: MonthGroup[] = [];
let currentKey = '';

for (const post of posts) {
	const d = post.data.pubDate;
	const key = `${d.getFullYear()}-${d.getMonth()}`;
	if (key !== currentKey) {
		monthGroups.push({
			label: d.toLocaleDateString('en-us', { month: 'long' }),
			posts: [post],
		});
		currentKey = key;
	} else {
		monthGroups[monthGroups.length - 1].posts.push(post);
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`All Posts — ${SITE_TITLE}`} description="Archive of all blog posts" />
		<style>
			main {
				padding-top: 48px;
			}

			.page-title {
				margin-bottom: 48px;
			}

			.month-section {
				display: flex;
				flex-direction: column;
				gap: 24px;
			}

			.month-section + .month-section {
				margin-top: 48px;
			}

			.month-heading {
				font-size: 20px;
				line-height: 1.4;
				color: var(--text-muted);
			}

			.posts-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 32px;
			}

			.post-item {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.post-title {
				font-size: 18px;
				line-height: 1.555;
				color: var(--brand);
			}

			.post-title a {
				color: inherit;
				text-decoration: none;
			}

			.post-title a:hover {
				text-decoration: underline;
			}

			.post-meta {
				display: inline-flex;
				align-items: center;
				gap: 12px;
				color: var(--text-muted);
				font-size: 14px;
				line-height: 1.428;
			}

			.reading-time {
				display: inline-flex;
				align-items: center;
				gap: 4px;
			}

			.clock-icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 14px;
				height: 14px;
			}

			.clock-icon :global(svg) {
				width: 14px;
				height: 14px;
				display: block;
			}

			.post-description {
				color: var(--text-muted);
				font-size: 14px;
				line-height: 1.428;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">All Posts</h1>
			{
				monthGroups.map((group) => (
					<section class="month-section">
						<h2 class="month-heading">{group.label}</h2>
						<ul class="posts-list">
							{group.posts.map((post) => (
								<li>
									<article class="post-item">
										<h3 class="post-title">
											<a href={`/posts/${post.id}/`}>{post.data.title}</a>
										</h3>
										<p class="post-meta">
											<time datetime={post.data.pubDate.toISOString()}>
												{post.data.pubDate.toLocaleDateString('en-us', {
													month: 'long',
													day: 'numeric',
												})}
											</time>
											<span class="reading-time">
												<span class="clock-icon" aria-hidden="true" set:html={clockIcon} />
												{estimateReadingTime(post.body ?? '').replace(' read', '')}
											</span>
										</p>
										<p class="post-description">{post.data.description}</p>
									</article>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
